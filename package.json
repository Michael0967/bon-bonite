{
  "name": "bon-bonite",
  "version": "1.0.0",
  "author": "Michael Rojas",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --env-file-if-exists=.env ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:debug": "BB_BROWSER=chromium node --import tsx --env-file-if-exists=.env ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile no-retry",
    "test:single": "node --import tsx --env-file-if-exists=.env ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile single",
    "test:feature": "node --import tsx --env-file-if-exists=.env ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile single",
    "report": "node scripts/generate-report.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "multiple-cucumber-html-reporter": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
